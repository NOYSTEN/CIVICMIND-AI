# CivicMind AI Configuration

# Server
PORT=3001
NODE_ENV=development

# AI Provider Settings
# If GEMINI_API_KEY is not set or empty, CivicMind AI seamlessly runs its fully explainable deterministic fallback pipeline.
GEMINI_API_KEY=
AI_PROVIDER=fallback

# Storage & Database
DATABASE_TYPE=supabase
DATABASE_PROVIDER=supabase
DATABASE_PATH=./server/data/civicmind.json
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Supabase Credentials
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Client (Vite) Supabase Settings
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Demo & Prototyping
DEMO_MODE=true
